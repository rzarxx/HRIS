# Alamat backend Go. Kosongkan untuk memakai API sementara bawaan Next.js (/api/v1, data dummy).
NEXT_PUBLIC_API_URL=

# Tampilkan petunjuk akun demo di halaman login (1 = ya). Matikan di produksi.
NEXT_PUBLIC_DEMO_MODE=1

# --- Hanya untuk API sementara ---
# Rahasia penandatangan JWT. WAJIB diganti di server bersama.
JWT_SECRET=ganti-dengan-string-acak-panjang
# Password akun SDM hasil seed (dipakai saat data pertama dibuat / di-reset).
SEED_SDM_PASSWORD=pejuang123
# Izinkan cookie tanpa HTTPS saat `npm start` di jaringan lokal (1 = ya).
INSECURE_COOKIE=1
