[Unit]
Description=HRIS Pejuang: hapus selfie lebih dari 90 hari
After=network.target postgresql.service
# Dilewati di server yang belum menjalankan setup-face.sh.
ConditionPathIsDirectory=/opt/hris/selfies

[Service]
Type=oneshot
User=hris
Group=hris
WorkingDirectory=/opt/hris
# Membaca /opt/hris/.env sendiri, sama seperti API.
ExecStart=/opt/hris/hris-purge-selfies
TimeoutStartSec=35min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hris/selfies
